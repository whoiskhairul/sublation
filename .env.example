# -------------------------------------------------------------
# Sublation / Folia BPMN Platform - Environment Variables Template
# Copy this file to .env and configure for your target environment.
# -------------------------------------------------------------

# --- Django Core Settings ---
DEBUG=False
DJANGO_SECRET_KEY=generate-a-strong-random-secret-key-here
DJANGO_ALLOWED_HOSTS=localhost 127.0.0.1 [::1] folia.sublation.tech yourdomain.com

# --- Database (PostgreSQL) ---
# Format: postgres://USER:PASSWORD@HOST:PORT/NAME or configure individual variables
DATABASE_URL=postgres://sublation:Planspiel@localhost:5432/folia
DB_NAME=folia
DB_USER=sublation
DB_PASSWORD=Planspiel
DB_HOST=localhost
DB_PORT=5432

# --- Redis / ASGI WebSocket Channel Layer ---
# For cloud providers like Railway, Heroku, or AWS ElastiCache, provide REDIS_URL
# e.g., redis://default:password@host:port
REDIS_URL=
REDISHOST=127.0.0.1
REDISPORT=6379
USE_REDIS=False

# --- AI Integration (Google Gemini via OpenAI SDK) ---
# Gemini API Key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-2.5-flash

# --- Encryption (Fernet key for URL tokens & diagram IDs) ---
# Generate using: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=ssDAwNlUOP2Fhx0detImHvEv5fg_1qMBh4px8UeYnAQ=

# --- Security & CORS / CSRF ---
CORS_ALLOWED_ORIGINS=https://folia.sublation.tech https://yourdomain.com
CSRF_TRUSTED_ORIGINS=https://folia.sublation.tech https://yourdomain.com
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_SAMESITE=Lax

# --- Google OAuth (Social Login) ---
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- Email Notifications (SMTP) ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=teamsublation@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=teamsublation@gmail.com

# --- Frontend (Vite) Environment Variables ---
# In production, set these during build or provide via environment:
# VITE_API_URL=https://api.yourdomain.com
# VITE_SOCKET_URL=wss://api.yourdomain.com
